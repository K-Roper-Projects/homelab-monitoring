# AWS deployment settings
aws_region    = "us-east-1"
instance_type = "t3.small"

# Existing EC2 key pair in the target AWS account
key_name = "your-key-pair-name"

# Network access
# Replace with trusted public IPv4 CIDR(s), e.g. 203.0.113.10/32
allowed_ssh_cidr        = "YOUR_PUBLIC_IP/32"
allowed_monitoring_cidr = "YOUR_PUBLIC_IP/32"

# EC2 root storage
root_volume_size = 20
root_volume_type = "gp3"

# AMI must exist in the selected AWS region
ami_id = "ami-xxxxxxxxxxxxxxxxx"

# EC2 Name tag
instance_name = "Monitoring-Server"